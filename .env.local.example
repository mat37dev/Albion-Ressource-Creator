# Database (Vercel Postgres / Prisma Postgres)
# Utilisez POSTGRES_URL ou DATABASE_URL depuis votre dashboard Vercel
DATABASE_URL=postgres://default:xxx@xxx.postgres.vercel-storage.com:5432/verceldb?sslmode=require

# Alternative: Utilisez POSTGRES_PRISMA_URL pour WebSocket (recommandé en entreprise)
# POSTGRES_PRISMA_URL=postgres://default:xxx@xxx-pooler.postgres.vercel-storage.com/verceldb?sslmode=require&pgbouncer=true

# Driver de connexion
# Par défaut, utilise le driver Serverless (WebSocket sur port 443)
# Décommentez pour forcer le driver classique (nécessite port 5432 ouvert)
# USE_SERVERLESS_DRIVER=false

# App
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# Supabase (optionnel, si vous utilisez Supabase pour l'auth/storage)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
